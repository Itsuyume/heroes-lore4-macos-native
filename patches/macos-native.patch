new file mode 100644
index 0000000..6316940
--- /dev/null
+++ b/src/macos_synth.c
@@ -0,0 +1,96 @@
+#include <AudioToolbox/AudioToolbox.h>
+#include <CoreServices/CoreServices.h>
+#include <stdbool.h>
+#include <stdlib.h>
+
+enum { HL_SAMPLE_RATE = 48000, HL_CHANNELS = 2, HL_MAX_FRAMES = 4096 };
+
+typedef struct {
+    AudioUnit synth;
+    Float64 sample_time;
+    bool initialized;
+    Float32 channels[HL_CHANNELS][HL_MAX_FRAMES];
+} HLSynth;
+
+void hl_synth_close(HLSynth *state) {
+    if (!state) return;
+    if (state->synth) {
+        if (state->initialized) AudioUnitUninitialize(state->synth);
+        AudioComponentInstanceDispose(state->synth);
+    }
+    free(state);
+}
+
+OSStatus hl_synth_open(HLSynth **result) {
+    if (!result) return paramErr;
+    *result = NULL;
+    AudioComponentDescription description = { kAudioUnitType_MusicDevice,
+        kAudioUnitSubType_DLSSynth, kAudioUnitManufacturer_Apple, 0, 0 };
+    AudioComponent component = AudioComponentFindNext(NULL, &description);
+    if (!component) return kAudio_ParamError;
+    HLSynth *state = calloc(1, sizeof(*state));
+    if (!state) return memFullErr;
+    OSStatus status = AudioComponentInstanceNew(component, &state->synth);
+    if (status) goto fail;
+    AudioStreamBasicDescription format = {
+        .mSampleRate = HL_SAMPLE_RATE,
+        .mFormatID = kAudioFormatLinearPCM,
+        .mFormatFlags = kAudioFormatFlagsNativeFloatPacked | kAudioFormatFlagIsNonInterleaved,
+        .mBytesPerPacket = sizeof(Float32),
+        .mFramesPerPacket = 1,
+        .mBytesPerFrame = sizeof(Float32),
+        .mChannelsPerFrame = HL_CHANNELS,
+        .mBitsPerChannel = 8 * sizeof(Float32),
+    };
+    status = AudioUnitSetProperty(state->synth, kAudioUnitProperty_StreamFormat,
+        kAudioUnitScope_Output, 0, &format, sizeof(format));
+    if (status) goto fail;
+    UInt32 max_frames = HL_MAX_FRAMES;
+    status = AudioUnitSetProperty(state->synth, kAudioUnitProperty_MaximumFramesPerSlice,
+        kAudioUnitScope_Global, 0, &max_frames, sizeof(max_frames));
+    if (status) goto fail;
+    status = AudioUnitInitialize(state->synth);
+    if (status) goto fail;
+    state->initialized = true;
+    *result = state;
+    return noErr;
+fail:
+    hl_synth_close(state);
+    return status;
+}
+
+OSStatus hl_synth_send(HLSynth *state, const unsigned char *bytes, unsigned int len) {
+    if (!state || !bytes || !len) return paramErr;
+    if (bytes[0] == 0xF0) return MusicDeviceSysEx(state->synth, bytes, len);
+    if (len > 3) return paramErr;
+    return MusicDeviceMIDIEvent(state->synth, bytes[0], len > 1 ? bytes[1] : 0,
+        len > 2 ? bytes[2] : 0, 0);
+}
+
+// The caller serializes MIDI events and rendering, and owns frames * 2 floats.
+OSStatus hl_synth_render(HLSynth *state, float *interleaved_stereo, unsigned int frames) {
+    if (!state || frames > HL_MAX_FRAMES) return paramErr;
+    if (!frames) return noErr;
+    if (!interleaved_stereo) return paramErr;
+    struct { UInt32 count; AudioBuffer buffers[HL_CHANNELS]; } output = {
+        .count = HL_CHANNELS,
+        .buffers = {
+            {1, frames * sizeof(Float32), state->channels[0]},
+            {1, frames * sizeof(Float32), state->channels[1]},
+        },
+    };
+    AudioTimeStamp timestamp = {
+        .mSampleTime = state->sample_time,
+        .mFlags = kAudioTimeStampSampleTimeValid,
+    };
+    AudioUnitRenderActionFlags flags = 0;
+    OSStatus status = AudioUnitRender(state->synth, &flags, &timestamp, 0, frames,
+        (AudioBufferList *)&output);
+    if (status) return status;
+    for (unsigned int frame = 0; frame < frames; ++frame) {
+        interleaved_stereo[frame * HL_CHANNELS] = state->channels[0][frame];
+        interleaved_stereo[frame * HL_CHANNELS + 1] = state->channels[1][frame];
+    }
+    state->sample_time += frames;
+    return noErr;
+}
