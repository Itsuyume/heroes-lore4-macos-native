new file mode 100644
index 0000000..204760f
--- /dev/null
+++ b/src/macos_synth.c
@@ -0,0 +1,53 @@
+#include <AudioToolbox/AudioToolbox.h>
+#include <stdlib.h>
+#include <CoreServices/CoreServices.h>
+
+typedef struct { AUGraph graph; AudioUnit synth; } HLSynth;
+
+void hl_synth_close(HLSynth *state) {
+    if (!state) return;
+    if (state->graph) {
+        AUGraphStop(state->graph);
+        DisposeAUGraph(state->graph);
+    }
+    free(state);
+}
+
+OSStatus hl_synth_open(HLSynth **result) {
+    HLSynth *state = calloc(1, sizeof(*state));
+    if (!state) return memFullErr;
+    AUNode synth_node, output_node;
+    AudioComponentDescription synth = { kAudioUnitType_MusicDevice,
+        kAudioUnitSubType_DLSSynth, kAudioUnitManufacturer_Apple, 0, 0 };
+    AudioComponentDescription output = { kAudioUnitType_Output,
+        kAudioUnitSubType_DefaultOutput, kAudioUnitManufacturer_Apple, 0, 0 };
+    OSStatus status = NewAUGraph(&state->graph);
+    if (status) goto fail;
+    status = AUGraphAddNode(state->graph, &synth, &synth_node);
+    if (status) goto fail;
+    status = AUGraphAddNode(state->graph, &output, &output_node);
+    if (status) goto fail;
+    status = AUGraphOpen(state->graph);
+    if (status) goto fail;
+    status = AUGraphNodeInfo(state->graph, synth_node, NULL, &state->synth);
+    if (status) goto fail;
+    status = AUGraphConnectNodeInput(state->graph, synth_node, 0, output_node, 0);
+    if (status) goto fail;
+    status = AUGraphInitialize(state->graph);
+    if (status) goto fail;
+    status = AUGraphStart(state->graph);
+    if (status) goto fail;
+    *result = state;
+    return noErr;
+fail:
+    hl_synth_close(state);
+    return status;
+}
+
+OSStatus hl_synth_send(HLSynth *state, const unsigned char *bytes, unsigned int len) {
+    if (!len) return paramErr;
+    if (bytes[0] == 0xF0) return MusicDeviceSysEx(state->synth, bytes, len);
+    if (len > 3) return paramErr;
+    return MusicDeviceMIDIEvent(state->synth, bytes[0], len > 1 ? bytes[1] : 0,
+        len > 2 ? bytes[2] : 0, 0);
+}
