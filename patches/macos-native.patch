--- /dev/null
+++ b/src/app_config.rs
@@ -0,0 +1,55 @@
+use std::{
+    ffi::OsString,
+    path::{Path, PathBuf},
+};
+
+pub const TITLE: &str = "영웅서기 4 — 환영의 가면";
+
+pub fn data_dir() -> PathBuf {
+    directories::ProjectDirs::from("local", "HeroesLore", "HeroesLore4")
+        .expect("macOS user data directory must exist")
+        .data_dir()
+        .to_owned()
+}
+
+pub fn bundled_game(executable: &Path) -> Option<PathBuf> {
+    let macos = executable.parent()?;
+    if macos.file_name()? != "MacOS" {
+        return None;
+    }
+    let contents = macos.parent()?;
+    if contents.file_name()? != "Contents" {
+        return None;
+    }
+    Some(contents.join("Resources/game.zip"))
+}
+
+pub fn launch_args() -> anyhow::Result<Vec<OsString>> {
+    let mut args: Vec<_> = std::env::args_os().collect();
+    if args.len() == 1
+        && let Some(game) = bundled_game(&std::env::current_exe()?)
+    {
+        anyhow::ensure!(game.is_file(), "Bundled game data is missing: {}", game.display());
+        args.push(game.into_os_string());
+    }
+    Ok(args)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn resolves_moved_bundle_and_unicode_paths() {
+        let path = Path::new("/Applications/영웅서기 4.app/Contents/MacOS/HeroesLore4");
+        assert_eq!(
+            bundled_game(path),
+            Some(PathBuf::from("/Applications/영웅서기 4.app/Contents/Resources/game.zip"))
+        );
+    }
+    #[test]
+    fn leaves_command_line_binary_without_default_game() {
+        assert_eq!(bundled_game(Path::new("/tmp/wie")), None);
+        assert_eq!(bundled_game(Path::new("wie")), None);
+        assert_eq!(bundled_game(Path::new("/tmp/Other/MacOS/wie")), None);
+    }
+}
