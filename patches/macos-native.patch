diff --git a/src/midi_output.rs b/src/midi_output.rs
new file mode 100644
index 0000000..258394d
--- /dev/null
+++ b/src/midi_output.rs
@@ -0,0 +1,65 @@
+use midir::{MidiOutput, MidiOutputConnection};
+
+pub enum MidiConnection {
+    External(MidiOutputConnection),
+    #[cfg(target_os = "macos")]
+    Builtin(macos::Synth),
+}
+
+impl MidiConnection {
+    pub fn send(&mut self, data: &[u8]) -> anyhow::Result<()> {
+        match self {
+            Self::External(connection) => connection.send(data).map_err(|e| anyhow::anyhow!(e.to_string())),
+            #[cfg(target_os = "macos")]
+            Self::Builtin(synth) => synth.send(data),
+        }
+    }
+}
+
+pub fn open(requested: Option<usize>) -> anyhow::Result<MidiConnection> {
+    #[cfg(target_os = "macos")]
+    if requested.is_none() {
+        let synth = macos::Synth::new()?;
+        tracing::info!("Using macOS built-in DLS synthesizer");
+        return Ok(MidiConnection::Builtin(synth));
+    }
+    let midi = MidiOutput::new("HeroesLore4")?;
+    let ports = midi.ports();
+    let index = crate::select_midi_output_index(ports.len(), requested).ok_or_else(|| anyhow::anyhow!("No MIDI output port"))?;
+    let connection = midi.connect(&ports[index], "HeroesLore4").map_err(|e| anyhow::anyhow!(e.to_string()))?;
+    Ok(MidiConnection::External(connection))
+}
+
+#[cfg(target_os = "macos")]
+mod macos {
+    use std::{ffi::c_void, ptr::NonNull};
+    unsafe extern "C" {
+        fn hl_synth_open(result: *mut *mut c_void) -> i32;
+        fn hl_synth_close(state: *mut c_void);
+        fn hl_synth_send(state: *mut c_void, bytes: *const u8, len: u32) -> i32;
+    }
+    pub struct Synth(NonNull<c_void>);
+    impl Synth {
+        pub fn new() -> anyhow::Result<Self> {
+            let mut ptr = std::ptr::null_mut();
+            // The C constructor transfers ownership only after successful initialization.
+            let status = unsafe { hl_synth_open(&mut ptr) };
+            anyhow::ensure!(status == 0, "macOS synthesizer initialization failed: {status}");
+            Ok(Self(NonNull::new(ptr).ok_or_else(|| anyhow::anyhow!("Synthesizer returned null"))?))
+        }
+        pub fn send(&mut self, data: &[u8]) -> anyhow::Result<()> {
+            anyhow::ensure!(!data.is_empty(), "Empty MIDI message");
+            let len = u32::try_from(data.len())?;
+            // Both buffers remain valid for the synchronous C call.
+            let status = unsafe { hl_synth_send(self.0.as_ptr(), data.as_ptr(), len) };
+            anyhow::ensure!(status == 0, "macOS MIDI event failed: {status}");
+            Ok(())
+        }
+    }
+    impl Drop for Synth {
+        fn drop(&mut self) {
+            // This is the unique owner of the graph allocated by hl_synth_open.
+            unsafe { hl_synth_close(self.0.as_ptr()) };
+        }
+    }
+}
