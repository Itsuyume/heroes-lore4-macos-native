@@ -0,0 +1,36 @@
+use midir::{MidiOutput, MidiOutputConnection};
+
+pub enum MidiConnection {
+    External(MidiOutputConnection),
+    #[cfg(target_os = "macos")]
+    Builtin(macos::Synth),
+}
+
+impl MidiConnection {
+    pub fn send(&mut self, data: &[u8]) -> anyhow::Result<()> {
+        match self {
+            Self::External(connection) => connection.send(data).map_err(|e| anyhow::anyhow!(e.to_string())),
+            #[cfg(target_os = "macos")]
+            Self::Builtin(synth) => synth.send(data),
+        }
+    }
+}
+
+pub fn open(requested: Option<usize>, _mixer: Option<&rodio::mixer::Mixer>) -> anyhow::Result<MidiConnection> {
+    #[cfg(target_os = "macos")]
+    if requested.is_none() {
+        let mixer = _mixer.ok_or_else(|| anyhow::anyhow!("PCM output required for the built-in synthesizer"))?;
+        let synth = macos::Synth::new()?;
+        mixer.add(synth.source());
+        tracing::info!("Using macOS built-in DLS synthesizer");
+        return Ok(MidiConnection::Builtin(synth));
+    }
+    let midi = MidiOutput::new("HeroesLore4")?;
+    let ports = midi.ports();
+    let index = crate::select_midi_output_index(ports.len(), requested).ok_or_else(|| anyhow::anyhow!("No MIDI output port"))?;
+    let connection = midi.connect(&ports[index], "HeroesLore4").map_err(|e| anyhow::anyhow!(e.to_string()))?;
+    Ok(MidiConnection::External(connection))
+}
+
+#[cfg(target_os = "macos")]
+mod macos;
diff --git a/src/midi_output/macos.rs b/src/midi_output/macos.rs
new file mode 100644
index 0000000..99a396c
--- /dev/null
+++ b/src/midi_output/macos.rs
@@ -0,0 +1,152 @@
+use std::{
+    ffi::c_void,
+    num::NonZero,
+    ptr::NonNull,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use rodio::Source;
+
+const CHANNELS: u16 = 2;
+const SAMPLE_RATE: u32 = 48_000;
+const BUFFER_SAMPLES: usize = 512;
+
+unsafe extern "C" {
+    fn hl_synth_open(result: *mut *mut c_void) -> i32;
+    fn hl_synth_close(state: *mut c_void);
+    fn hl_synth_send(state: *mut c_void, bytes: *const u8, len: u32) -> i32;
+    fn hl_synth_render(state: *mut c_void, samples: *mut f32, frames: u32) -> i32;
+}
+
+struct Instrument(NonNull<c_void>);
+// All access, including rendering and MIDI delivery, is serialized by Synth's mutex.
+unsafe impl Send for Instrument {}
+impl Drop for Instrument {
+    fn drop(&mut self) {
+        // The last Arc owns the unique C allocation after rendering has stopped.
+        unsafe { hl_synth_close(self.0.as_ptr()) };
+    }
+}
+
+#[derive(Clone)]
+pub struct Synth(Arc<Mutex<Instrument>>);
+impl Synth {
+    pub fn new() -> anyhow::Result<Self> {
+        let mut ptr = std::ptr::null_mut();
+        // The C constructor transfers ownership only on success.
+        let status = unsafe { hl_synth_open(&mut ptr) };
+        anyhow::ensure!(status == 0, "macOS synthesizer initialization failed: {status}");
+        let instrument = Instrument(NonNull::new(ptr).ok_or_else(|| anyhow::anyhow!("Synthesizer returned null"))?);
+        Ok(Self(Arc::new(Mutex::new(instrument))))
+    }
+
+    pub fn send(&mut self, data: &[u8]) -> anyhow::Result<()> {
+        anyhow::ensure!(!data.is_empty(), "Empty MIDI message");
+        let len = u32::try_from(data.len())?;
+        let instrument = self.0.lock().map_err(|_| anyhow::anyhow!("Synthesizer lock poisoned"))?;
+        // Both buffers stay valid for the synchronous call under the render lock.
+        let status = unsafe { hl_synth_send(instrument.0.as_ptr(), data.as_ptr(), len) };
+        anyhow::ensure!(status == 0, "macOS MIDI event failed: {status}");
+        Ok(())
+    }
+
+    pub fn source(&self) -> SynthSource {
+        SynthSource {
+            synth: self.clone(),
+            samples: [0.0; BUFFER_SAMPLES],
+            offset: BUFFER_SAMPLES,
+            failed: false,
+        }
+    }
+
+    fn render(&self, samples: &mut [f32; BUFFER_SAMPLES]) -> anyhow::Result<()> {
+        let instrument = self.0.lock().map_err(|_| anyhow::anyhow!("Synthesizer lock poisoned"))?;
+        // The interleaved stereo array holds exactly the requested frame count.
+        let status = unsafe { hl_synth_render(instrument.0.as_ptr(), samples.as_mut_ptr(), (BUFFER_SAMPLES / CHANNELS as usize) as u32) };
+        anyhow::ensure!(status == 0, "macOS synthesizer render failed: {status}");
+        Ok(())
+    }
+}
+
+pub struct SynthSource {
+    synth: Synth,
+    samples: [f32; BUFFER_SAMPLES],
+    offset: usize,
+    failed: bool,
+}
+impl Iterator for SynthSource {
+    type Item = f32;
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.failed {
+            return None;
+        }
+        if self.offset == self.samples.len() {
+            if let Err(error) = self.synth.render(&mut self.samples) {
+                tracing::error!(%error, "Stopping failed MIDI renderer");
+                self.failed = true;
+                return None;
+            }
+            self.offset = 0;
+        }
+        let sample = self.samples[self.offset];
+        self.offset += 1;
+        Some(sample)
+    }
+}
+impl Source for SynthSource {
+    fn current_span_len(&self) -> Option<usize> {
+        None
+    }
+    fn channels(&self) -> NonZero<u16> {
+        NonZero::new(CHANNELS).unwrap()
+    }
+    fn sample_rate(&self) -> NonZero<u32> {
+        NonZero::new(SAMPLE_RATE).unwrap()
+    }
+    fn total_duration(&self) -> Option<Duration> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Synth;
+
+    #[test]
+    fn idle_rendering_then_midi_note_produces_audio() {
+        let mut synth = Synth::new().unwrap();
+        let mut source = synth.source();
+        for _ in 0..480_000 {
+            assert!(source.next().unwrap().abs() < 0.000001);
+        }
+        assert!(synth.send(&[]).is_err());
+        synth.send(&[0xc0, 0]).unwrap();
+        synth.send(&[0xb0, 7, 100]).unwrap();
+        synth.send(&[0x90, 60, 100]).unwrap();
+        let peak = source.by_ref().take(48_000).map(f32::abs).fold(0.0, f32::max);
+        assert!(peak > 0.001, "silent synth after five seconds of idle audio: {peak}");
+        synth.send(&[0x80, 60, 0]).unwrap();
+    }
+
+    #[test]
+    fn pcm_effects_and_midi_share_output_after_idle() {
+        use rodio::{Player, buffer::SamplesBuffer, mixer::mixer};
+        use std::num::NonZero;
+        let channels = NonZero::new(2).unwrap();
+        let rate = NonZero::new(48_000).unwrap();
+        let (input, mut output) = mixer(channels, rate);
+        let mut synth = Synth::new().unwrap();
+        input.add(synth.source());
+        let player = Player::connect_new(&input);
+        for _ in 0..480_000 {
+            assert!(output.next().unwrap().abs() < 0.000001);
+        }
+        synth.send(&[0x90, 60, 100]).unwrap();
+        player.append(SamplesBuffer::new(channels, rate, vec![0.75; 512]));
+        let effect_peak = output.by_ref().take(1024).map(f32::abs).fold(0.0, f32::max);
+        assert!(effect_peak > 0.6, "PCM effect did not reach shared output");
+        let music_peak = output.by_ref().take(48_000).map(f32::abs).fold(0.0, f32::max);
+        assert!(music_peak > 0.001, "MIDI did not continue after PCM effect ended");
+    }
+}
